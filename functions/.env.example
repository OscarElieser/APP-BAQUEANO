# ============================================================================
# 🧭 BAQUEANO ECOSYSTEM — PLANTILLA DE ENTORNO PARA FUNCTIONS (.env.example)
# ============================================================================
# 🎯 1. POR QUÉ:
# - Permitir configurar claves de API (Gemini, Groq, Supabase) en Firebase Functions
#   mediante variables de entorno estándar sin requerir Google Secret Manager ni
#   cuenta de facturación habilitada para la API de secretos.
#
# ⚙️ 2. CÓMO:
# - Copiar este archivo a functions/.env y asignar las credenciales correspondientes.
#
# 📦 3. QUÉ:
# ============================================================================

NODE_ENV=production
AI_PROVIDER=gemini
AI_MAX_TOKENS=1500
AI_RATE_LIMIT=10

# Claves de IA
GEMINI_API_KEY=
GROQ_API_KEY=

# Supabase
SUPABASE_PROJECT_REF=heiudfpthqwtjrtluqlm
SUPABASE_URL=https://heiudfpthqwtjrtluqlm.supabase.co
SUPABASE_ANON_KEY=sb_publishable_q7ZhqRIRjlerZK7WOu_Qxw_X_AqXV1d
SUPABASE_SERVICE_ROLE_KEY=
