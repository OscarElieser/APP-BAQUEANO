# ============================================================================
# 🧭 BAQUEANO — CABECERAS EN CLOUDFLARE (website/_headers)
# 🎯 POR QUÉ: 2026-10-15 el propietario retira Azure; el sitio se publica con
#   Cloudflare Workers (static assets). Mismas cabeceras que tenía Nginx
#   (azure/nginx/baqueano-security-headers.conf), que se conserva sin cambios.
# ⚙️ CÓMO: Cloudflare lee este archivo de la salida (dist-hostinger/_headers).
# ============================================================================
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(self), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://apis.google.com https://www.googletagmanager.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; media-src 'self' blob: https://heiudfpthqwtjrtluqlm.supabase.co; img-src 'self' data: blob: https://heiudfpthqwtjrtluqlm.supabase.co https://*.openstreetmap.org https://firebasestorage.googleapis.com https://lh3.googleusercontent.com https://*.google.com https://*.googleapis.com https://*.gstatic.com https://*.arcgisonline.com https://*.cartocdn.com https://images.unsplash.com https://video-previews.elements.envatousercontent.com; connect-src 'self' https://api.open-meteo.com https://*.supabase.co wss://*.supabase.co https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebaseinstallations.googleapis.com https://*.google.com https://*.arcgisonline.com https://nominatim.openstreetmap.org https://valhalla1.openstreetmap.de https://app-baqueano.web.app; worker-src 'self' blob:; child-src 'self' blob:; frame-src https://app-baqueano.firebaseapp.com; object-src 'none'; base-uri 'self';

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, no-cache, must-revalidate

/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: public, max-age=300, must-revalidate

/health.json
  Cache-Control: no-store
