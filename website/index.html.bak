    <!-- ============================================================================
         🧭 01. HERO NICARAGUA — IDENTIDAD SOBERANA & PUERTA DE ENTRADA
         🎯 Por qué: Comunicar en los primeros segundos de navegación que BAQUEANO
            es la puerta digital auténtica para descubrir Nicaragua, priorizando
            el territorio, los volcanes, lagos, costas y familias campesinas.
         ⚙️ Cómo: Fotografía real de alta fidelidad, titular patrio enfático,
            llamados a la acción claros ("Explorar Nicaragua" y "Crear mi Ruta"),
            brújula 3D Rumbo Baqueano y mosaico visual de destinos emblemáticos.
         📦 Qué: Sección .hero-section-nicaragua con manifiesto y composición visual.
         ============================================================================ -->
    <section class="hero-section-nicaragua" id="heroNicaragua">
      <img src="assets/images/destinos/cerro_negro.jpg" alt="Volcán Cerro Negro, Nicaragua" class="hero-nicaragua-bg-media">
      <div class="hero-nicaragua-overlay"></div>
      
      <div class="container hero-nicaragua-grid">
        <!-- Columna Izquierda: Mensaje y Acción -->
        <div class="hero-nicaragua-content">
          <div class="hero-tag-badge">
            <span class="pulse-dot"></span> Ecoturismo auténtico en Nicaragua
          </div>
          
          <h1 class="hero-main-title">
            Descubre la <span class="highlight-terra">Nicaragua</span> que no sale en el mapa
          </h1>
          
          <p class="hero-main-subtitle">
            Volcanes, playas, cultura, gastronomía y experiencias auténticas guiadas por quienes conocen el territorio.
          </p>

          <div class="hero-manifesto-subtle">
            El sendero lo abren las comunidades.
          </div>

          <!-- Rumbo Baqueano: Brújula 3D Interactiva -->
          <div class="hero-compass-interactive" id="heroCompass3D" title="Brújula Baqueano 3D interactiva">
            <div class="compass-dial">
              <div class="compass-ring"></div>
              <div class="compass-needle" id="heroCompassNeedle"></div>
              <span class="compass-marker marker-n">N</span>
              <span class="compass-marker marker-s">S</span>
              <span class="compass-marker marker-e">E</span>
              <span class="compass-marker marker-w">O</span>
              <div class="compass-center-dot"></div>
            </div>
            <div class="compass-legend">
              <strong>Rumbo Baqueano</strong>
              <span>Nicaragua 12.86° N, 85.20° O</span>
            </div>
          </div>

          <!-- Botones de Acción Primarios -->
          <div class="hero-actions-strip">
            <a href="#exploraNicaragua" class="btn-cta-explore">
              <i class="fa-solid fa-compass"></i> Explorar Nicaragua
            </a>
            <a href="#routeBuilderSection" class="btn-cta-route">
              <i class="fa-solid fa-route"></i> Crear mi Ruta
            </a>
          </div>

          <!-- Acceso sutil a descarga APK -->
          <div class="hero-apk-subtle-wrap">
            <button type="button" class="hero-apk-subtle-btn open-download-modal-btn" title="Descargar APK oficial para Android">
              <i class="fa-brands fa-android"></i> Descargar App APK (Modo sin conexión &amp; GPS)
            </button>
          </div>
        </div>

        <!-- Columna Derecha: Mosaico Visual de Destinos Emblemáticos de Nicaragua -->
        <div class="hero-nicaragua-mosaic">
          <!-- Tarjeta Destacada: Isla de Ometepe -->
          <div class="mosaic-card card-featured">
            <img src="assets/images/destinos/isla_de_ometepe.jpg" alt="Isla de Ometepe" class="mosaic-img">
            <div class="mosaic-overlay">
              <span class="mosaic-badge"><i class="fa-solid fa-water"></i> Rivas · Gran Lago</span>
              <h3 class="mosaic-title">Isla de Ometepe</h3>
              <p class="mosaic-meta">Reserva de Biósfera entre dos volcanes sagrados</p>
            </div>
          </div>

          <!-- Tarjeta 2: Volcán Masaya -->
          <div class="mosaic-card">
            <img src="assets/images/destinos/volcan_masaya.jpg" alt="Volcán Masaya" class="mosaic-img">
            <div class="mosaic-overlay">
              <span class="mosaic-badge"><i class="fa-solid fa-volcano"></i> Masaya</span>
              <h4 class="mosaic-title">Volcán Masaya</h4>
              <p class="mosaic-meta">Cráter Santiago activo</p>
            </div>
          </div>

          <!-- Tarjeta 3: Cañón de Somoto -->
          <div class="mosaic-card">
            <img src="assets/images/destinos/canon_de_somoto.jpg" alt="Cañón de Somoto" class="mosaic-img">
            <div class="mosaic-overlay">
              <span class="mosaic-badge"><i class="fa-solid fa-mountain"></i> Madriz</span>
              <h4 class="mosaic-title">Cañón de Somoto</h4>
              <p class="mosaic-meta">Paredes milenarias y río Coco</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================================
         🧭 02. BUSCADOR / EXPLORADOR PRINCIPAL
         🎯 Por qué: Proveer interacción y búsqueda inmediata tras el primer impacto visual,
            evitando la sensación de página pasiva de scroll infinito.
         ⚙️ Cómo: Formulario con redirección a destinos.html?q=... y chips de acceso rápido.
         📦 Qué: Contenedor #homeSearchSection con selector de categoría y búsqueda libre.
         ============================================================================ -->
    <section class="home-search-section" id="homeSearchSection">
      <div class="container">
        <div class="home-search-card">
          <label for="homeSearchInput" class="home-search-label">
            <i class="fa-solid fa-magnifying-glass"></i> ¿Qué querés descubrir en Nicaragua?
          </label>
          <form class="home-search-form" action="destinos.html" method="GET">
            <div class="home-search-input-wrap">
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <input type="text" id="homeSearchInput" name="q" class="home-search-input"
                     placeholder="Playa, volcán, restaurante, hotel, museo, comunidad..."
                     autocomplete="off" required>
            </div>
            <button type="submit" class="home-search-submit">
              <i class="fa-solid fa-arrow-right"></i> <span>Buscar</span>
            </button>
          </form>

          <!-- Chips de Búsqueda Rápida -->
          <div class="home-search-chips">
            <span class="chips-label">Atajos directos:</span>
            <a href="destinos.html?cat=volcanes" class="search-chip"><i class="fa-solid fa-volcano"></i> Volcanes</a>
            <a href="destinos.html?cat=playas" class="search-chip"><i class="fa-solid fa-umbrella-beach"></i> Playas</a>
            <a href="destinos.html?cat=lagunas" class="search-chip"><i class="fa-solid fa-water"></i> Lagos &amp; Lagunas</a>
            <a href="destinos.html?cat=naturaleza" class="search-chip"><i class="fa-solid fa-leaf"></i> Reservas Naturales</a>
            <a href="gastronomia.html" class="search-chip"><i class="fa-solid fa-bowl-food"></i> Gastronomía</a>
            <a href="#experienciasNicaragua" class="search-chip"><i class="fa-solid fa-person-hiking"></i> Aventura</a>
            <a href="historia.html" class="search-chip"><i class="fa-solid fa-scroll"></i> Historia</a>
            <a href="aliados.html" class="search-chip"><i class="fa-solid fa-handshake-angle"></i> Comunidades</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================================
         🧭 03. EXPLORA NICARAGUA (10 CATEGORÍAS VISUALES)
         🎯 Por qué: Estimular la exploración geográfica inmediata mediante 10 tarjetas
            visuales interactivas con fotografías reales del patrimonio nicaragüense.
         ⚙️ Cómo: CSS Grid de 10 tarjetas con hover elevado, descripción concisa y enlace.
         📦 Qué: Bloque #exploraNicaragua con tarjetas de Playas, Volcanes, Islas, Lagos,
            Ríos, Naturaleza, Historia, Cultura, Gastronomía y Comunidades.
         ============================================================================ -->
    <section class="categories-nicaragua-section" id="exploraNicaragua">
      <div class="container">
        <div class="section-head-nicaragua">
          <div class="section-tag-pill">
            <i class="fa-solid fa-compass"></i> Diversidad Geográfica &amp; Patrimonial
          </div>
          <h2 class="section-title-nicaragua">Explora Nicaragua</h2>
          <p class="section-sub-nicaragua">
            Desde las olas del Pacífico hasta la calma coralina del Caribe, cada rincón de la patria guarda una historia viva esperando por vos.
          </p>
        </div>

        <div class="categories-grid-10">
          <!-- 1. Playas -->
          <a href="destinos.html?cat=playas" class="category-card-pro">
            <img src="assets/images/destinos/Bahía de San Juan del Sur & Mirador del Cristo.jpg" alt="Playas de Nicaragua" class="category-card-img" loading="lazy">
            <div class="category-card-overlay">
              <h3 class="category-card-title">Playas</h3>
              <p class="category-card-desc">Santuarios de surf en el Pacífico y descanso costero</p>
              <span class="category-card-cta">Explorar <i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <!-- 2. Volcanes -->
          <a href="destinos.html?cat=volcanes" class="category-card-pro">
            <img src="assets/images/destinos/cerro_negro.jpg" alt="Volcanes de Nicaragua" class="category-card-img" loading="lazy">
            <div class="category-card-overlay">
              <h3 class="category-card-title">Volcanes</h3>
              <p class="category-card-desc">Cordillera de los Maribios, cráteres activos y sandboarding</p>
              <span class="category-card-cta">Explorar <i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <!-- 3. Islas -->
          <a href="destinos.html?cat=islas" class="category-card-pro">
            <img src="assets/images/destinos/isla_de_ometepe.jpg" alt="Islas de Nicaragua" class="category-card-img" loading="lazy">
            <div class="category-card-overlay">
              <h3 class="category-card-title">Islas</h3>
              <p class="category-card-desc">Ometepe en el Gran Lago y el paraíso de Corn Island</p>
              <span class="category-card-cta">Explorar <i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <!-- 4. Lagos y Lagunas -->
          <a href="destinos.html?cat=lagunas" class="category-card-pro">
            <img src="assets/images/destinos/laguna_de_apoyo.jpg" alt="Lagos y Lagunas de Nicaragua" class="category-card-img" loading="lazy">
            <div class="category-card-overlay">
              <h3 class="category-card-title">Lagos &amp; Lagunas</h3>
              <p class="category-card-desc">Aguas minerales de cráter en Apoyo y el inmenso Cocibolca</p>
              <span class="category-card-cta">Explorar <i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <!-- 5. Ríos y Cascadas -->
          <a href="destinos.html?cat=rios" class="category-card-pro">
            <img src="assets/images/destinos/cascada_la_luna.jpg" alt="Ríos y Cascadas de Nicaragua" class="category-card-img" loading="lazy">
            <div class="category-card-overlay">
              <h3 class="category-card-title">Ríos &amp; Cascadas</h3>
              <p class="category-card-desc">Cañones milenarios en Somoto y saltos de agua norteños</p>
              <span class="category-card-cta">Explorar <i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <!-- 6. Naturaleza -->
          <a href="destinos.html?cat=naturaleza" class="category-card-pro">
            <img src="assets/images/departamentos/biosfera bosawas.jpg" alt="Naturaleza de Nicaragua" class="category-card-img" loading="lazy">
            <div class="category-card-overlay">
              <h3 class="category-card-title">Naturaleza</h3>
              <p class="category-card-desc">Reserva de Biosfera Bosawás, nebliselvas y aviturismo</p>
              <span class="category-card-cta">Explorar <i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <!-- 7. Historia -->
          <a href="historia.html" class="category-card-pro">
            <img src="assets/images/destinos/Casa Señorial Colonial Granada.jpg" alt="Historia de Nicaragua" class="category-card-img" loading="lazy">
            <div class="category-card-overlay">
              <h3 class="category-card-title">Historia</h3>
              <p class="category-card-desc">Ciudades coloniales, fortalezas y la epopeya nacional</p>
              <span class="category-card-cta">Explorar <i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <!-- 8. Cultura -->
          <a href="destinos.html?cat=cultura" class="category-card-pro">
            <img src="assets/images/destinos/Calle La Calzada & Zona Bohemia.jpg" alt="Cultura de Nicaragua" class="category-card-img" loading="lazy">
            <div class="category-card-overlay">
              <h3 class="category-card-title">Cultura</h3>
              <p class="category-card-desc">Artesanía de barro en Masaya, danzas y patrimonio vivo</p>
              <span class="category-card-cta">Explorar <i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <!-- 9. Gastronomía -->
          <a href="gastronomia.html" class="category-card-pro">
            <img src="assets/images/comida/gallo_pinto.jpg" alt="Gastronomía de Nicaragua" class="category-card-img" loading="lazy">
            <div class="category-card-overlay">
              <h3 class="category-card-title">Gastronomía</h3>
              <p class="category-card-desc">Nacatamal, vigorón, baho, quesillos y sabor campesino</p>
              <span class="category-card-cta">Explorar <i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <!-- 10. Comunidades -->
          <a href="aliados.html" class="category-card-pro">
            <img src="assets/images/aliados/posada_ecologica_la_abuela.jpg" alt="Comunidades Campesinas de Nicaragua" class="category-card-img" loading="lazy">
            <div class="category-card-overlay">
              <h3 class="category-card-title">Comunidades</h3>
              <p class="category-card-desc">Cooperativas campesinas y hospedaje rural de custodia directa</p>
