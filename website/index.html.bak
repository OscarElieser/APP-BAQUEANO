<section class="impacts-section-pro">
      <div class="container">
        <div class="section-lead-header">
          <div class="badge-section-pill">
            <i class="fa-solid fa-circle-check"></i> Compromiso Comunitario
          </div>
          <h2 class="section-headline">Los 5 Impactos Fundamentales de Baqueano</h2>
          <p class="section-subtext">
            Baqueano evalúa y cumple de forma transparente cada uno de los criterios exigidos
            para proyectos de alto valor socioecológico y viabilidad sostenible.
          </p>
        </div>

        <!-- Galería Dinámica en Movimiento Infinito -->
        <div class="impacts-marquee-wrapper" id="impactsMarqueeWrapper">
          <div class="impacts-marquee-track" id="impactsMarqueeTrack">
            <!-- SET 1 (Original) -->
            <!-- Impacto 1 -->
            <div class="impact-hex-card">
              <div class="impact-number-tag">IMPACTO 01 • ECOLÓGICO</div>
              <div class="impact-icon-circle"><i class="fa-solid fa-leaf"></i></div>
              <h3 class="impact-card-title">Impacto Ambiental & Custodia</h3>
              <p class="impact-card-desc">
                Turismo de huella cero. Monitoreo constante de la capacidad de carga en senderos frágiles,
                prohibición de plásticos de un solo uso y canal de denuncias ciudadanas georreferenciadas.
              </p>
              <ul class="impact-check-list">
                <li><i class="fa-solid fa-check"></i> Decálogo verde de obligatorio cumplimiento</li>
                <li><i class="fa-solid fa-check"></i> Protección activa de cuencas y lagunas de cráter</li>
                <li><i class="fa-solid fa-check"></i> Conservación de fauna silvestre nativa</li>
              </ul>
            </div>

            <!-- Impacto 2 -->
            <div class="impact-hex-card">
              <div class="impact-number-tag">IMPACTO 02 • SOCIAL</div>
              <div class="impact-icon-circle"><i class="fa-solid fa-users"></i></div>
              <h3 class="impact-card-title">Impacto Social & Comunitario</h3>
              <p class="impact-card-desc">
                Empoderamiento del campesino como dueño legítimo de su destino turístico. Inclusión de mujeres
                y jóvenes rurales como embajadores culturales, traductores y custodios del bosque.
              </p>
              <ul class="impact-check-list">
                <li><i class="fa-solid fa-check"></i> Capacitación continua en primeros auxilios y rescate</li>
                <li><i class="fa-solid fa-check"></i> Respeto absoluto a la privacidad comunitaria</li>
                <li><i class="fa-solid fa-check"></i> Fondos compartidos para escuelas y caminos rurales</li>
              </ul>
            </div>

            <!-- Impacto 3 -->
            <div class="impact-hex-card">
              <div class="impact-number-tag">IMPACTO 03 • ECONÓMICO</div>
              <div class="impact-icon-circle"><i class="fa-solid fa-hand-holding-dollar"></i></div>
              <h3 class="impact-card-title">Impacto Económico & Distribución</h3>
              <p class="impact-card-desc">
                Ruptura del monopolio de plataformas transnacionales que retienen hasta el 25% de los ingresos.
                El 100% de la tarifa pactada llega a la mano del guía y la cooperativa anfitriona.
              </p>
              <ul class="impact-check-list">
                <li><i class="fa-solid fa-check"></i> Cero intermediarios abusivos en la reserva</li>
                <li><i class="fa-solid fa-check"></i> Dinamización de comedores y posadas familiares</li>
                <li><i class="fa-solid fa-check"></i> Régimen fiscal transparente con Ley No. 1210 y 1211 INTUR</li>
              </ul>
            </div>

            <!-- Impacto 4 -->
            <div class="impact-hex-card">
              <div class="impact-number-tag">IMPACTO 04 • GOBERNANZA</div>
              <div class="impact-icon-circle"><i class="fa-solid fa-scale-balanced"></i></div>
              <h3 class="impact-card-title">Gobernanza, Ética & Legalidad</h3>
              <p class="impact-card-desc">
                Cumplimiento estricto del marco jurídico nacional (Ley No. 1210 General de Turismo, Ley No. 1211 de Incentivos Turísticos, Ley 217 del Medio Ambiente).
                Transparencia contable bimoneda y arquitectura de datos cifrada en Firestore.
              </p>
              <ul class="impact-check-list">
                <li><i class="fa-solid fa-check"></i> Sincronización con normativas INTUR</li>
                <li><i class="fa-solid fa-check"></i> Centro de telemetría y contingencia en tiempo real</li>
                <li><i class="fa-solid fa-check"></i> Protocolos de seguridad comunitaria y geolocalización GPS</li>
              </ul>
            </div>

            <!-- Impacto 5 -->
            <div class="impact-hex-card">
              <div class="impact-number-tag">IMPACTO 05 • CULTURAL</div>
              <div class="impact-icon-circle"><i class="fa-solid fa-landmark"></i></div>
              <h3 class="impact-card-title">Cultura, Memoria & Soberanía</h3>
              <p class="impact-card-desc">
                Rescate de la memoria histórica de Nicaragua: las 7 eras fundacionales, la cosmovisión del maíz,
                las leyendas campesinas, el son tradicional de marimba y la sabiduría botánica ancestral.
              </p>
              <ul class="impact-check-list">
                <li><i class="fa-solid fa-check"></i> Módulo insignia de los 17 territorios soberanos</li>
                <li><i class="fa-solid fa-check"></i> Vitrina gastronómica de las abuelas campesinas</li>
                <li><i class="fa-solid fa-check"></i> Patrimonio sonoro a 1 toque con música folclórica</li>
              </ul>
            </div>

            <!-- Tarjeta Extra: Seguridad Integral -->
            <div class="impact-hex-card index-inline-012">
              <div class="impact-number-tag index-inline-013">SEGURIDAD 24/7 EN SENDERO</div>
              <div class="impact-icon-circle index-inline-014"><i class="fa-solid fa-triangle-exclamation"></i></div>
              <h3 class="impact-card-title">Centro de Auxilio SOS & GPS</h3>
              <p class="impact-card-desc">
                Geolocalización GPS con lectura de coordenadas satelitales en tu teléfono sin necesidad de señal telefónica.
                Enlace con Cruz Blanca (128), Bomberos (115) y Policía Nacional (118).
              </p>
              <ul class="impact-check-list">
                <li><i class="fa-solid fa-check"></i> Coordenadas GPS exactas en 1 toque</li>
                <li><i class="fa-solid fa-check"></i> Despacho de auxilio por WhatsApp (requiere datos)</li>
                <li><i class="fa-solid fa-check"></i> Red de guías en alerta permanente</li>
              </ul>
            </div>

          </div>
        </div>

        <!-- Controles Interactivos -->
        <div class="impacts-marquee-controls">
          <button class="marquee-control-btn" id="btnToggleMarquee" onclick="toggleImpactsMarquee()">
            <i class="fa-solid fa-pause" id="marqueeToggleIcon"></i> <span id="marqueeToggleText">Pausar Movimiento</span>
          </button>
          <span class="index-inline-015">
            <i class="fa-solid fa-hand-pointer"></i> Pasa el cursor o mantén presionado para leer con calma
          </span>
        </div>
      </div>
    </section>


    <!-- ============================================================================
         🧭 14. APP BAQUEANO ("BAQUEANO también viaja contigo")
         🎯 Por qué: Alojar el simulador interactivo de smartphone y la descarga de APK
            en una sección tecnológica dedicada sin competir con el Hero patrio.
         ⚙️ Cómo: Reubica el contenedor .phone-frame-wrap con #baqueanoReels y botones de descarga.
         📦 Qué: Sección #appBaqueanoSection con especificaciones y portal APK oficial.
         ============================================================================ -->
    <section class="app-baqueano-section" id="appBaqueanoSection">
      <div class="container">
        <div class="app-showcase-grid">
          <!-- Columna Izquierda: Información de la Aplicación Móvil y Descarga -->
          <div class="app-showcase-info">
            <div class="section-tag-pill">
              <i class="fa-brands fa-android"></i> Aplicación Móvil Oficial
            </div>
            <h2 class="section-title-nicaragua">BAQUEANO también viaja contigo</h2>
            <p class="section-sub-nicaragua">
              Lleva la tecnología Baqueano a zonas remotas sin señal celular. Mapas topográficos sin conexión, baliza de auxilio satelital y conexión directa con guías locales.
            </p>

            <div class="app-features-list">
              <div class="app-feature-row">
                <div class="app-feature-icon"><i class="fa-solid fa-map-location-dot"></i></div>
                <div>
                  <h4>Mapas Topográficos Sin Conexión</h4>
                  <p>Descarga rutas y puntos georreferenciados para navegar sin cobertura celular.</p>
                </div>
              </div>
              <div class="app-feature-row">
                <div class="app-feature-icon"><i class="fa-solid fa-shield-halved"></i></div>
                <div>
                  <h4>Baliza de Auxilio SOS 24/7</h4>
                  <p>Transmisión de coordenadas exactas por satélite y enlace con cuerpos de socorro.</p>
                </div>
              </div>
              <div class="app-feature-row">
                <div class="app-feature-icon"><i class="fa-solid fa-route"></i></div>
                <div>
                  <h4>Rutas y Favoritos Personalizados</h4>
                  <p>Guarda tus destinos, calcula presupuestos e itinerarios a tu medida.</p>
                </div>
              </div>
              <div class="app-feature-row">
                <div class="app-feature-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
                <div>
                  <h4>Baqueano Digital Integrado</h4>
                  <p>Asistente de inteligencia artificial para resolver dudas en el sendero.</p>
                </div>
              </div>
            </div>

            <div class="download-specs-bar" style="margin-bottom: 20px;">
              <span class="spec-chip"><i class="fa-brands fa-android"></i> Android 8.0 o superior</span>
              <span class="spec-chip"><i class="fa-solid fa-hard-drive"></i> Peso: ~56 MB</span>
              <span class="spec-chip"><i class="fa-solid fa-shield-halved"></i> APK Seguro y Firmado</span>
              <span class="spec-chip"><i class="fa-solid fa-ban"></i> 100% Libre de Publicidad</span>
            </div>

            <div class="download-cta-double" style="margin-bottom: 16px;">
              <button class="btn-cta-explore open-download-modal-btn">
                <i class="fa-brands fa-android"></i> Descargar App APK Oficial
              </button>
              <button class="btn-cta-route open-download-modal-btn">
                <i class="fa-solid fa-circle-question"></i> Guía Paso a Paso
              </button>
            </div>

            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
              <button class="btn-admin-action" id="shareWhatsAppBtn">
                <i class="fa-brands fa-whatsapp"></i> Compartir por WhatsApp
              </button>
              <button class="btn-admin-action" id="copyLinkBtn">
                <i class="fa-solid fa-link"></i> Copiar Enlace Oficial
              </button>
            </div>
          </div>

          <!-- Columna Derecha: Mockup del Smartphone con Baqueano Reels -->
          <div class="app-showcase-phone" style="display:flex;justify-content:center;">
            <div class="phone-frame-wrap">
              <div class="phone-hardware">
                <div class="phone-notch"><div class="camera-lens"></div></div>
                <div class="phone-screen baqueano-reels" id="baqueanoReels" tabindex="0" role="region" aria-label="Descubre Nicaragua, feed vertical de rutas">
                  <div class="baqueano-reels-feed" id="baqueanoReelsFeed"></div>
                  <div class="baqueano-reels-indicators" id="baqueanoReelsIndicators" aria-hidden="true"></div>
                  <nav class="baqueano-reels-dock" aria-label="Navegación de la aplicación Baqueano">
                    <a class="is-active" href="#inicio"><i class="fa-solid fa-house"></i><span>Inicio</span></a>
                    <a href="#routeBuilderSection"><i class="fa-solid fa-route"></i><span>Rutas</span></a>
                    <a href="#experienciasNicaragua"><i class="fa-solid fa-heart"></i><span>Favoritos</span></a>
                    <a href="perfil.html"><i class="fa-solid fa-user"></i><span>Perfil</span></a>
                  </nav>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>



    <!-- ============================================================================
         🧭 15. SOS / SEGURIDAD TERRITORIAL 24/7
         🎯 Por qué: Garantizar que la ayuda de emergencia siempre esté visible y accesible,
            reservando el color rojo exclusivamente para llamadas a la acción críticas de socorro.
         ⚙️ Cómo: Tarjeta con números directos (Cruz Blanca, Bomberos, Policía) y llamada modal.
         📦 Qué: Bloque #sosSeguridadSection con disparador para #sosModal.
         ============================================================================ -->
    <section class="sos-security-section" id="sosSeguridadSection">
      <div class="container">
        <div class="sos-security-card">
          <div class="sos-info-side">
            <div class="badge-section-pill" style="border-color: rgba(220,38,38,0.5); color:#EF4444; background: rgba(220,38,38,0.1);">
              <i class="fa-solid fa-shield-halved"></i> Auxilio &amp; Georreferenciación 24/7
            </div>
            <h2 class="sos-card-title">Seguridad y Auxilio en <span class="sos-highlight">Sendero 24/7</span></h2>
            <p class="sos-card-desc">
              Explora con tranquilidad. En caso de incidente en ruta, contás con asistencia inmediata y geolocalización satelital enlazada a las autoridades y comités de socorro nacional.
            </p>

            <div class="sos-numbers-row">
              <a href="tel:128" class="sos-num-item">
                <span class="sos-num-val">128</span>
                <span class="sos-num-lbl"><i class="fa-solid fa-truck-medical"></i> Cruz Blanca</span>
              </a>
              <a href="tel:115" class="sos-num-item">
                <span class="sos-num-val">115</span>
                <span class="sos-num-lbl"><i class="fa-solid fa-fire-extinguisher"></i> Bomberos</span>
              </a>
              <a href="tel:118" class="sos-num-item">
                <span class="sos-num-val">118</span>
                <span class="sos-num-lbl"><i class="fa-solid fa-shield-halved"></i> Policía Nacional</span>
              </a>
            </div>
          </div>

          <div class="sos-action-box">
            <i class="fa-solid fa-triangle-exclamation" style="font-size:36px;color:#EF4444;"></i>
            <h4 style="margin:0;color:#FFFFFF;font-family:'Montserrat',sans-serif;font-size:17px;font-weight:800;">¿Estás en una emergencia?</h4>
            <p class="sos-note">Presiona para abrir la baliza con tus coordenadas GPS actuales y despacho directo.</p>
            <button type="button" class="sos-trigger-btn" onclick="const m=document.getElementById('sosModal'); if(m){ m.classList.add('is-open'); m.setAttribute('aria-hidden','false'); }">
              <i class="fa-solid fa-tower-broadcast"></i> Abrir Centro de Auxilio SOS
            </button>
          </div>
        </div>
      </div>
    </section>


<!-- MODAL INTERACTIVO PARA COMPARTIR EXPERIENCIA -->
    <div class="exp-modal-backdrop" id="modalAddExperience" aria-hidden="true" role="dialog">
      <div class="exp-modal-card">
        <div class="exp-modal-header">
          <h3 class="exp-modal-title"><i class="fa-solid fa-comment-dots"></i> Comparte tu Experiencia</h3>
          <button type="button" class="exp-modal-close-btn" id="btnCloseExpModal" aria-label="Cerrar">&times;</button>
        </div>

        <form id="formAddExperience">
          <div class="exp-form-field">
            <label for="expAuthor" class="exp-form-label">Tu Nombre Completo *</label>
            <input type="text" id="expAuthor" class="exp-form-input" placeholder="Ej: María José Morales" required>
          </div>

          <div class="exp-form-field">
            <label for="expRoleType" class="exp-form-label">¿Cuál es tu rol en el territorio? *</label>
            <select id="expRoleType" class="exp-form-select">
              <option value="turista-local">Turista Nacional (Nicaragüense)</option>
              <option value="turista-inter">Viajero / Turista Internacional</option>
              <option value="negocio">Dueño de Negocio / Anfitrión Campesino</option>
            </select>
          </div>

          <div class="exp-form-field">
            <label for="expLocation" class="exp-form-label">Tu Ciudad, País o Comunidad</label>
            <input type="text" id="expLocation" class="exp-form-input" placeholder="Ej: Estelí, Nicaragua o Madrid, España">
          </div>

          <div class="exp-form-field">
            <label for="expRating" class="exp-form-label">Valoración General *</label>
            <select id="expRating" class="exp-form-select">
              <option value="5">★★★★★ (5 Estrellas - Extraordinario)</option>
              <option value="4">★★★★☆ (4 Estrellas - Muy Bueno)</option>
              <option value="3">★★★☆☆ (3 Estrellas - Bueno)</option>
            </select>
          </div>

          <div class="exp-form-field">
            <label for="expComment" class="exp-form-label">Cuéntanos tu experiencia *</label>
            <textarea id="expComment" class="exp-form-textarea" rows="3" placeholder="¿Cómo fue tu visita o cómo ha beneficiado Baqueano a tu comunidad o negocio local?" required></textarea>
          </div>

          <!-- ZONA DE UPLOAD FOTO / VIDEO -->
          <div class="exp-form-field">
            <label class="exp-form-label">
              <i class="fa-solid fa-photo-film" style="color:#F65E01;margin-right:0.35rem;"></i>
              Foto o Video de tu Experiencia
              <span class="exp-upload-badge">Opcional</span>
            </label>

            <!-- Drop Zone -->
            <div class="exp-upload-zone" id="expUploadZone" role="button" tabindex="0" aria-label="Subir foto o video">
              <input type="file" id="expMediaInput" class="exp-upload-hidden" accept="image/*,video/*" multiple aria-hidden="true">
              <div class="exp-upload-zone-inner">
                <div class="exp-upload-icon-wrap">
                  <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>
                <p class="exp-upload-hint-primary">Arrastra o haz clic para subir</p>
                <p class="exp-upload-hint-secondary">Imágenes (JPG, PNG, WEBP) · Videos (MP4, MOV) · Máx. 4 archivos</p>
                <div class="exp-upload-pills">
                  <span class="exp-upload-pill"><i class="fa-solid fa-image"></i> Foto</span>
                  <span class="exp-upload-pill"><i class="fa-solid fa-clapperboard"></i> Video</span>
                </div>
              </div>
            </div>

            <!-- Previews -->
            <div class="exp-media-preview-grid" id="expMediaPreviewGrid" aria-live="polite"></div>
          </div>

          <div class="exp-modal-actions">
            <button type="button" class="btn-exp-cancel" id="btnCancelExpModal">Cancelar</button>
            <button type="submit" class="btn-exp-submit">
              <i class="fa-solid fa-paper-plane"></i> Publicar Experiencia
            </button>
          </div>
        </form>
      </div>
    </div>


    <!-- MODAL DE CONFIRMACIÓN DE REGISTRO DE NEGOCIO -->
    <div class="modal-backdrop-pro" id="bizSuccessModal" aria-hidden="true" role="dialog">
      <div class="modal-card-dialog index-inline-026">
        <button class="modal-close-x" id="closeBizModalBtn" aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
        <div class="modal-icon-top index-inline-027">
          <i class="fa-solid fa-circle-check index-inline-028"></i>
        </div>
        <h3 class="index-inline-029">¡Postulación Recibida con Éxito!</h3>
        <p class="index-inline-030">
