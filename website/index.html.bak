      <div class="footer-biz-register-card" id="registroNegocios">
        <!-- Encabezado de la Tarjeta -->
        <div class="footer-biz-header-wrap">
          <div class="footer-biz-tag">
            <i class="fa-solid fa-handshake-angle index-inline-039"></i> RED DE ANFITRIONES & COMERCIO JUSTO
          </div>
