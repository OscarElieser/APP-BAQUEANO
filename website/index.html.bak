        <a href="tel:128" class="sos-phone-card"><i class="fa-solid fa-truck-medical index-inline-054"></i><div><h5 class="index-inline-055">Cruz Blanca</h5><span class="index-inline-056">128</span></div></a>
        <a href="tel:115" class="sos-phone-card"><i class="fa-solid fa-fire-extinguisher index-inline-057"></i><div><h5 class="index-inline-055">Bomberos</h5><span class="index-inline-056">115</span></div></a>
        <a href="tel:118" class="sos-phone-card"><i class="fa-solid fa-shield-halved index-inline-058"></i><div><h5 class="index-inline-055">Policía Nacional</h5><span class="index-inline-056">118</span></div></a>
        <a href="tel:50584431289" class="sos-phone-card"><i class="fa-brands fa-whatsapp index-inline-059"></i><div><h5 class="index-inline-055">Mesa Baqueano</h5><span class="index-inline-056">WhatsApp SOS</span></div></a>
      </div>
