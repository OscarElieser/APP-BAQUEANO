            </div>
            <div class="footer-biz-benefit-item">
              <i class="fa-solid fa-shield-heart"></i>
              <span><strong>Auditoría & Respaldo</strong> Mesa Baqueano</span>
            </div>
          </div>

          <!-- Botón de Acción Principal para Abrir la Postulación -->
          <div class="biz-trigger-wrap">
            <button type="button" class="biz-btn-submit biz-btn-toggle" id="btnToggleBizForm" aria-expanded="false" aria-controls="bizFormCollapse">
              <span class="btn-text"><i class="fa-brands fa-whatsapp"></i> Postular Negocio a Mesa Baqueano</span>
              <i class="fa-solid fa-arrow-right btn-arrow" id="toggleBizArrow"></i>
            </button>
          </div>
        </div>

        <!-- Contenedor Desplegable del Formulario (Abre al dar click) -->
        <div id="bizFormCollapse" class="biz-form-collapse" aria-hidden="true">
          <div class="biz-form-header-bar">
            <div class="biz-form-header-info">
              <i class="fa-solid fa-file-signature index-inline-040"></i>
              <span>Formulario Oficial de Inscripción — Red de Anfitriones Baqueano</span>
            </div>
            <button type="button" class="biz-btn-close-form" id="btnCloseBizFormTop" title="Ocultar formulario">
              <i class="fa-solid fa-chevron-up"></i> Ocultar
            </button>
          </div>

          <!-- Formulario de Registro -->
          <form id="registerBusinessForm" class="biz-form" novalidate>
            <div class="biz-form-grid">
              
              <!-- 1. Nombre del Negocio -->
              <div class="biz-field-group">
                <label for="bizName" class="biz-label">
                  <i class="fa-solid fa-store"></i> Nombre del Negocio / Emprendimiento <span class="req">*</span>
                </label>
                <input type="text" id="bizName" name="bizName" class="biz-input" placeholder="Ej: Comedor Doña María / Eco-Lodge Las Brisas" required>
                <span class="biz-error-msg" id="err-bizName"></span>
              </div>

              <!-- 2. Tipo de Negocio -->
              <div class="biz-field-group">
                <label for="bizType" class="biz-label">
                  <i class="fa-solid fa-tags"></i> Tipo de Negocio <span class="req">*</span>
                </label>
                <select id="bizType" name="bizType" class="biz-select" required>
                  <option value="">Selecciona el tipo de negocio...</option>
                  <option value="Comedor Tradicional / Restaurante Campesino">Comedor Tradicional / Restaurante Campesino</option>
                  <option value="Hotel / Eco-Lodge">Hotel / Eco-Lodge</option>
                  <option value="Hostal Comunitario">Hostal Comunitario</option>
                  <option value="Hospedaje Rural Familiar">Hospedaje Rural Familiar</option>
                  <option value="Casa de Alquiler Vacacional">Casa de Alquiler Vacacional</option>
                  <option value="Guía Baqueano Comunitario">Guía Baqueano Comunitario</option>
                  <option value="Cooperativa Agroecológica">Cooperativa Agroecológica</option>
                  <option value="Taller de Artesanías / Recuerdos">Taller de Artesanías / Recuerdos</option>
                  <option value="Bar / Sunset Lounge Frente al Mar">Bar / Sunset Lounge Frente al Mar</option>
                  <option value="Museo / Patrimonio Histórico">Museo / Patrimonio Histórico</option>
                  <option value="Transporte Turístico / Bote">Transporte Turístico / Bote</option>
                  <option value="Otro">Otro Emprendimiento Local</option>
                </select>
                <span class="biz-error-msg" id="err-bizType"></span>
              </div>

              <!-- 3. Nombre del Propietario -->
              <div class="biz-field-group">
                <label for="bizOwner" class="biz-label">
                  <i class="fa-solid fa-user-tie"></i> Propietario o Responsable Directo <span class="req">*</span>
                </label>
                <input type="text" id="bizOwner" name="bizOwner" class="biz-input" placeholder="Ej: María Hernández Gómez" required>
                <span class="biz-error-msg" id="err-bizOwner"></span>
              </div>

              <!-- 4. Categoría Baqueano -->
              <div class="biz-field-group">
                <label for="bizCategory" class="biz-label">
                  <i class="fa-solid fa-layer-group"></i> Categoría en Catálogo Baqueano <span class="req">*</span>
                </label>
                <select id="bizCategory" name="bizCategory" class="biz-select" required>
                  <option value="">Selecciona una categoría oficial...</option>
                  <option value="gastronomia">Gastronomía Ancestral (Comedores, Baho, Quesillos)</option>
                  <option value="hoteles">Hoteles & Eco-Lodges</option>
                  <option value="hostales">Hostales de Aventura & Mochileros</option>
                  <option value="hospedajes">Hospedajes Rurales & Cabañas</option>
                  <option value="casas-alquiler">Casas de Alquiler & Villas</option>
                  <option value="museos">Museos, Cultura & Talleres</option>
                  <option value="discotecas">Vida Nocturna & Clubes de Playa</option>
                  <option value="rios">Ríos, Cascadas & Cañones</option>
                  <option value="volcanes">Volcanes & Sandboarding</option>
                  <option value="playas">Playas & Surf del Pacífico</option>
                </select>
                <span class="biz-error-msg" id="err-bizCategory"></span>
              </div>

              <!-- 5. Departamento -->
              <div class="biz-field-group">
                <label for="bizDepartment" class="biz-label">
                  <i class="fa-solid fa-map"></i> Departamento de Nicaragua <span class="req">*</span>
                </label>
                <select id="bizDepartment" name="bizDepartment" class="biz-select" required>
                  <option value="">Selecciona tu departamento...</option>
                  <option value="Boaco">Boaco</option>
                  <option value="Carazo">Carazo</option>
                  <option value="Chinandega">Chinandega</option>
                  <option value="Chontales">Chontales</option>
                  <option value="Costa Caribe Norte (RACCN)">Costa Caribe Norte (RACCN)</option>
                  <option value="Costa Caribe Sur (RACCS)">Costa Caribe Sur (RACCS)</option>
                  <option value="Estelí">Estelí</option>
                  <option value="Granada">Granada</option>
                  <option value="Jinotega">Jinotega</option>
                  <option value="León">León</option>
                  <option value="Madriz">Madriz</option>
                  <option value="Managua">Managua</option>
                  <option value="Masaya">Masaya</option>
                  <option value="Matagalpa">Matagalpa</option>
                  <option value="Nueva Segovia">Nueva Segovia</option>
                  <option value="Río San Juan">Río San Juan</option>
                  <option value="Rivas">Rivas</option>
                </select>
                <span class="biz-error-msg" id="err-bizDepartment"></span>
              </div>

              <!-- 6. Municipio -->
              <div class="biz-field-group">
                <label for="bizMunicipality" class="biz-label">
                  <i class="fa-solid fa-location-dot"></i> Municipio <span class="req">*</span>
                </label>
                <input type="text" id="bizMunicipality" name="bizMunicipality" class="biz-input" placeholder="Ej: San Juan del Sur, Somoto, Nagarote..." required>
                <span class="biz-error-msg" id="err-bizMunicipality"></span>
              </div>

              <!-- 7. Dirección Exacta -->
              <div class="biz-field-group biz-col-full">
                <label for="bizAddress" class="biz-label">
                  <i class="fa-solid fa-compass"></i> Dirección Exacta o Punto de Referencia <span class="req">*</span>
                </label>
                <input type="text" id="bizAddress" name="bizAddress" class="biz-input" placeholder="Ej: Del Parque Central 2 c. al lago, frente a la ermita comunitaria" required>
                <span class="biz-error-msg" id="err-bizAddress"></span>
              </div>

              <!-- 8. Teléfono Principal -->
              <div class="biz-field-group">
                <label for="bizPhone" class="biz-label">
                  <i class="fa-solid fa-phone"></i> Teléfono Principal de Llamadas <span class="req">*</span>
                </label>
                <input type="tel" id="bizPhone" name="bizPhone" class="biz-input" placeholder="+505 8888-0000" required>
                <span class="biz-error-msg" id="err-bizPhone"></span>
              </div>

              <!-- 9. WhatsApp de Reservas -->
              <div class="biz-field-group">
                <label for="bizWhatsapp" class="biz-label">
                  <i class="fa-brands fa-whatsapp"></i> WhatsApp para Reservas Directas
                </label>
                <input type="tel" id="bizWhatsapp" name="bizWhatsapp" class="biz-input" placeholder="+505 8443-0000">
              </div>

              <!-- 10. Correo Electrónico -->
              <div class="biz-field-group">
                <label for="bizEmail" class="biz-label">
                  <i class="fa-solid fa-envelope"></i> Correo Electrónico
                </label>
                <input type="email" id="bizEmail" name="bizEmail" class="biz-input" placeholder="contacto@tunegocio.com">
              </div>

              <!-- 11. Red Social / Sitio Web -->
              <div class="biz-field-group">
                <label for="bizWebsite" class="biz-label">
