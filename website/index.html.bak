      <p style="font-size: 0.76rem; color: rgba(244, 230, 193, 0.7); text-align: center; margin-top: 0.85rem; line-height: 1.4;">
        <i class="fa-solid fa-circle-info" style="color: #2DD4BF;"></i> Las coordenadas GPS se leen satelitalmente desde tu dispositivo móvil sin requerir internet. El despacho de alerta por WhatsApp requiere conectividad de datos móviles o red WiFi.
      </p>
    </div>
  </div>

  <!-- MODAL DE DESCARGA DE APK -->
  <div class="modal-backdrop-pro" id="downloadModal" aria-hidden="true" role="dialog">
    <div class="modal-card-dialog">
      <button class="modal-close-x" id="closeModalBtn" aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
      <div class="modal-icon-top"><img src="assets/images/logo.png" alt="Baqueano APK"></div>
      <h3 class="index-inline-029">Instalar Baqueano para Android</h3>
      <p class="index-inline-063">Descarga directa del paquete oficial v1.0.0 firmado para tu smartphone.</p>
      <div class="install-steps-vertical">
        <div class="step-row-item">
          <div class="step-badge-num">1</div>
          <div class="step-details"><h5>Descarga el APK</h5><p>Guarda el archivo seguro baqueanonicaragua.apk en tu almacenamiento.</p></div>
        </div>
        <div class="step-row-item">
          <div class="step-badge-num">2</div>
          <div class="step-details"><h5>Habilita Fuentes Desconocidas</h5><p>En Ajustes de Android, autoriza la instalación directa para tu explorador.</p></div>
        </div>
        <div class="step-row-item">
          <div class="step-badge-num">3</div>
          <div class="step-details"><h5>¡Comienza la Aventura!</h5><p>Abre la app y disfruta mapas fuera de línea y senderos sin intermediarios.</p></div>
        </div>
      </div>
      <div class="index-inline-064">
      </div>
    </div>
  </div>

  <!-- ============================================================================
       🧭 ASISTENTE BAQUEANO DIGITAL — GUÍA VIRTUAL DEL TERRITORIO
       🎯 Por qué: Brindar asistencia conversacional y contextual con identidad nica,
          ayudando a elegir destinos según presupuesto, días, normas ambientales y joyas ocultas.
       ⚙️ Cómo: Widget interactivo con avatar de Guardabarranco / Brújula, árbol de
          decisión contextual y conexión directa con el enfoque del mapa 3D.
       📦 Qué: Botón flotante #assistantFabBtn y panel deslizable #assistantChatDrawer.
       ============================================================================ -->
  <div class="baqueano-assistant-widget" id="baqueanoAssistantBox" hidden>
    <button type="button" class="assistant-fab-btn" id="assistantFabBtn" title="Consultar con Baqueano Digital" aria-label="Abrir Asistente Baqueano">
      <div class="assistant-avatar-badge">
        <i class="fa-solid fa-compass"></i>
      </div>
      <span class="assistant-fab-label">Guía Baqueano</span>
    </button>

    <div class="assistant-chat-drawer" id="assistantChatDrawer" aria-hidden="true">
      <div class="assistant-chat-header">
        <div class="assistant-identity-info">
          <div class="assistant-identity-icon"><i class="fa-solid fa-feather-pointed"></i></div>
          <div>
            <h4 class="assistant-name">Baqueano Digital</h4>
            <span class="assistant-tag">Guía Comunitario de Nicaragua</span>
          </div>
        </div>
        <button type="button" class="assistant-close-btn" id="btnCloseAssistant" aria-label="Cerrar Asistente">&times;</button>
      </div>

      <div class="assistant-messages-body" id="assistantMessagesBody">
        <!-- Mensaje de bienvenida inicial -->
        <div class="assistant-msg assistant-msg-bot">
          <p>¡Buenas amigo explorador! 🇳🇮 Soy tu guía <strong>Baqueano Digital</strong>. Te oriento para descubrir Nicaragua con respeto ambiental, precios justos y apoyo directo a nuestras familias campesinas. ¿Qué te gustaría consultar hoy?</p>
        </div>
      </div>

      <form class="assistant-query-form" id="assistantQueryForm">
        <label class="sr-only" for="assistantQueryInput">Escribí tu consulta sobre Nicaragua</label>
        <textarea id="assistantQueryInput" rows="2" maxlength="400" placeholder="Preguntá por destinos, rutas, precios o accesibilidad…" required></textarea>
        <button type="submit" id="assistantSendBtn" aria-label="Enviar consulta" title="Enviar consulta"><i class="fa-solid fa-paper-plane"></i></button>
      </form>

      <!-- Opciones Rápidas del Guía -->
      <div class="assistant-quick-prompts" id="assistantQuickPrompts">
        <button type="button" class="prompt-chip" data-action="budget" data-question="Tengo un presupuesto y quiero construir una ruta">
          <i class="fa-solid fa-coins"></i> Destinos según mi presupuesto
        </button>
        <button type="button" class="prompt-chip" data-action="days" data-question="¿Cómo puedo crear una ruta según mis días disponibles?">
          <i class="fa-solid fa-calendar-check"></i> Rutas por días disponibles
        </button>
        <button type="button" class="prompt-chip" data-action="green" data-question="¿Cuáles son las normas del Decálogo Verde?">
          <i class="fa-solid fa-leaf"></i> Decálogo Verde &amp; Normas
        </button>
        <button type="button" class="prompt-chip" data-action="hidden" data-question="Mostrame destinos menos conocidos con información registrada">
          <i class="fa-solid fa-gem"></i> Joyas ocultas poco conocidas
        </button>
        <button type="button" class="prompt-chip" data-action="map" data-question="Quiero explorar los destinos en el mapa">
          <i class="fa-solid fa-map-location-dot"></i> Enfocar Mapa 3D
        </button>
      </div>
    </div>
  </div>

  <!-- ============================================================================
       🧭 VISOR PANORÁMICO 360° — EXPERIENCIAS EN INMERSIÓN TOTAL
       🎯 Por qué: Ofrecer vistas panorámicas 360° esféricas con Three.js y síntesis
          de audio ambiental procedimental de la naturaleza nicaragüense.
       ⚙️ Cómo: Geometría esférica invertida con textura equirectangular, control
          de arrastre táctil y Web Audio API procedural.
       📦 Qué: Modal #panorama360Modal con controles de rotación y sonido ambiental.
       ============================================================================ -->
  <div class="panorama-360-modal" id="panorama360Modal" aria-hidden="true">
    <div class="panorama-modal-overlay" id="closePanoramaBackdrop"></div>
    <div class="panorama-modal-window">
      <div class="panorama-top-bar">
        <div class="panorama-title-wrap">
          <span class="panorama-icon"><i class="fa-solid fa-vr-cardboard"></i></span>
          <div>
            <h3 class="panorama-destination-name" id="panoDestinationTitle">Inmersión 360°</h3>
            <span class="panorama-sub-tag" id="panoDestinationSub">Nicaragua</span>
          </div>
        </div>
        <div class="panorama-controls-right">
          <button type="button" class="btn-pano-audio" id="btnTogglePanoAudio" title="Activar sonido ambiental de la naturaleza">
            <i class="fa-solid fa-volume-xmark" id="panoAudioIcon"></i>
            <span id="panoAudioLabel">Sonido</span>
          </button>
          <button type="button" class="btn-pano-close" id="btnClosePanorama" aria-label="Cerrar visor 360">&times;</button>
        </div>
      </div>

      <div class="panorama-canvas-wrap" id="panoramaCanvasContainer">
        <!-- Three.js Canvas se inyecta dinámicamente -->
        <div class="panorama-drag-hint">
          <i class="fa-solid fa-arrows-up-down-left-right"></i> Arrastra en cualquier dirección para explorar en 360°
        </div>
      </div>
    </div>
  </div>

  <!-- ======================================================================
       SDK FIREBASE & CONEXIÓN EN TIEMPO REAL
       🎯 Por qué: Eliminar datos semilla y sincronizar destinos, métricas y
          reservas directamente desde Cloud Firestore (/places, /businesses).
       ⚙️ Cómo: Firebase Compat v10 + Singleton de configuración oficial.
       ====================================================================== -->
  <script defer src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
  <script defer src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
  <script defer src="js/firebase-config.js"></script>
  <script src="js/website-business-catalog.js"></script>
  <script src="js/website-operations-catalog.js"></script>
  <script defer src="js/public-cms-sync.js"></script>

  <!-- Scripts Modulares del Ecosistema -->
  <script src="js/navigation.js"></script>
  <script src="js/video-registry.js"></script>
  <script src="js/firestore-realtime.js"></script>
  <script src="app.js"></script>

  <!-- Leaflet Map JS & Controlador de Territorio y Experiencias -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
  <script src="js/index-features.js"></script>

  <!-- ======================================================================
       🗺️ MAPA REAL DE NICARAGUA — LEAFLET + COORDENADAS WGS-84 AUTÉNTICAS
       🎯 Por qué: Reemplaza el canvas Three.js procesal por un mapa geográfico
          real que muestra los 17 territorios (15 departamentos y 2 regiones autónomas) con pines interactivos.
       ⚙️ Cómo: Leaflet 1.9.4 (ya cargado), marcadores SVG por tipo de destino,
          tiles topográficos Esri, popups enriquecidos y filtros de región.
       📦 Qué: window.BaqueanoRealMap con 17 pines en coordenadas reales de Nicaragua.
       ====================================================================== -->
  <script src="js/nicaragua-real-map.js"></script>
  <script src="js/route-builder.js"></script>
  <script src="js/baqueano-assistant.js?v=20260924-3"></script>
  <script src="js/panorama-viewer.js"></script>

  <!-- ======================================================================
       🧭 CONTROLADOR DE CENTRADO DE TARJETAS (CARDS) EN MAPAS REALES DE NICARAGUA
       🎯 Por qué: Garantizar que al hacer clic o seleccionar cualquier pin en el
          mapa real geográfico o en el mapa territorial de Nicaragua, la tarjeta
          informativa (card) se posicione automáticamente con precisión milimétrica
          en el centro exacto del visor cartográfico. Esto erradica recortes visuales,
          desbordes superiores contra la barra de navegación y desalineaciones laterales,
          asegurando legibilidad óptima y accesibilidad en cualquier resolución.
       ⚙️ Cómo: Interceptar los eventos de apertura cartográfica 'popupopen' en Leaflet.
          Se reubica el elemento DOM del card directamente en el contenedor del visor
          con la clase reactiva .baq-popup-centered (top: 50%, left: 50%, translate(-50%, -50%)),
          acompañado de un paneo suave (panTo) para enfocar las coordenadas satelitales
          del destino detrás de la tarjeta. Se gestiona además el cierre limpio al pulsar
          fuera del card o mediante el botón de cierre (&times;).
       📦 Qué: Controlador autoejecutable que registra hooks en L.Map.addInitHook y
          monitoriza de forma continua los visores cartográficos de la plataforma.
       ====================================================================== -->
  <script>
  (function() {
    'use strict';

    function attachCenteringToMap(map) {
      if (!map || map._baqCenteringAttached) return;
      map._baqCenteringAttached = true;

      const container = map.getContainer ? map.getContainer() : null;
      if (!container) return;

      map.on('popupopen', function(e) {
        const popup = e.popup;
        if (!popup) return;

        const popupEl = popup.getElement();
        if (popupEl && container) {
          if (popupEl.parentElement !== container) {
            container.appendChild(popupEl);
          }
          popupEl.classList.add('baq-popup-centered');

          const latLng = popup.getLatLng();
          if (latLng) {
            map.panTo(latLng, { animate: true, duration: 0.5 });
          }
        }
      });

      // Cierre reactivo si el usuario pulsa en el mapa fuera del card
      container.addEventListener('click', function(evt) {
        const popupEl = container.querySelector('.leaflet-popup.baq-popup-centered');
        if (!popupEl) return;
        if (!popupEl.contains(evt.target) && !evt.target.closest('.baqueano-map-pin, .baqueano-custom-leaflet-pin')) {
          map.closePopup();
        }
      });
    }

    // 1. Hook arquitectónico para toda nueva instancia de mapa Leaflet
    if (typeof L !== 'undefined' && L.Map && typeof L.Map.addInitHook === 'function') {
      L.Map.addInitHook(function() {
        attachCenteringToMap(this);
      });
    }

    // 2. Vinculación activa para mapas ya inicializados o con arranque asíncrono
    function syncActiveMaps() {
      if (window.BaqueanoRealMap && window.BaqueanoRealMap.map) {
        attachCenteringToMap(window.BaqueanoRealMap.map);
      }
      if (typeof L !== 'undefined') {
        const containers = document.querySelectorAll('#baqueano3dCanvasWrap, #indexTerritoryMap');
        containers.forEach(function(el) {
          if (el._leaflet_id && el._leaflet_map) {
            attachCenteringToMap(el._leaflet_map);
          }
        });
      }
    }

    syncActiveMaps();
    window.addEventListener('DOMContentLoaded', syncActiveMaps);
    setInterval(syncActiveMaps, 1000);
  })();
  </script>

  <!-- ======================================================================
       🧭 MANEJADOR DEL FORMULARIO DE REGISTRO DE NEGOCIOS (/businesses + WhatsApp)
       🎯 Por qué: Conectar de forma inmediata a los dueños de negocios locales con
          la Mesa Técnica Baqueano vía WhatsApp (+505 8443-1289) y registrar el
          anfitrión en Cloud Firestore (/businesses) para el Ops Center.
       ⚙️ Cómo: Validación reactiva de 16 campos, preview de fotografía, formateo
          con emojis y codificación URI para WhatsApp, modal de confirmación.
       📦 Qué: Controlador interactivo del formulario #registerBusinessForm.
       ====================================================================== -->
  <script>
  (function() {
    'use strict';

    const form = document.getElementById('registerBusinessForm');
    if (!form) return;

    const descInput = document.getElementById('bizDescription');
    const charCounter = document.getElementById('bizCharCounter');
    const photoInput = document.getElementById('bizPhoto');
    const placeholder = document.getElementById('bizUploadPlaceholder');
    const previewBox = document.getElementById('bizPhotoPreview');
    const previewImg = document.getElementById('bizPreviewImg');
    const btnRemovePhoto = document.getElementById('bizBtnRemovePhoto');
    const submitBtn = document.getElementById('btnSubmitBiz');
    const modal = document.getElementById('bizSuccessModal');
    const modalCloseBtn = document.getElementById('closeBizModalBtn');
    const modalAcceptBtn = document.getElementById('bizModalCloseBtn');
    const modalSummary = document.getElementById('bizModalSummary');
    const modalWhatsAppBtn = document.getElementById('bizModalWhatsAppBtn');

    // Elementos del Acordeón Desplegable
    const toggleBtn = document.getElementById('btnToggleBizForm');
    const formCollapse = document.getElementById('bizFormCollapse');
    const closeBtnTop = document.getElementById('btnCloseBizFormTop');

    function openBizForm(shouldScroll = true) {
      if (!formCollapse) return;
      formCollapse.classList.add('is-expanded');
      formCollapse.setAttribute('aria-hidden', 'false');
      if (toggleBtn) {
        toggleBtn.classList.add('is-open');
        toggleBtn.setAttribute('aria-expanded', 'true');
        const textSpan = toggleBtn.querySelector('.btn-text');
        if (textSpan) {
          textSpan.innerHTML = '<i class="fa-solid fa-chevron-up"></i> Ocultar Formulario de Postulación';
        }
      }
      if (shouldScroll) {
        setTimeout(() => {
          formCollapse.scrollIntoView({ behavior: 'smooth', block: 'start' });
          const firstInput = document.getElementById('bizName');
          if (firstInput) firstInput.focus();
        }, 180);
      }
    }

    function closeBizForm() {
      if (!formCollapse) return;
      formCollapse.classList.remove('is-expanded');
      formCollapse.setAttribute('aria-hidden', 'true');
      if (toggleBtn) {
        toggleBtn.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        const textSpan = toggleBtn.querySelector('.btn-text');
        if (textSpan) {
          textSpan.innerHTML = '<i class="fa-brands fa-whatsapp"></i> Postular Negocio a Mesa Baqueano';
        }
      }
    }

    function toggleBizForm() {
      if (formCollapse && formCollapse.classList.contains('is-expanded')) {
        closeBizForm();
      } else {
        openBizForm(true);
      }
    }

    if (toggleBtn) toggleBtn.addEventListener('click', toggleBizForm);
    if (closeBtnTop) closeBtnTop.addEventListener('click', closeBizForm);

    // Permitir abrir también al hacer clic en el encabezado (título o badge)
    const bizTitles = document.querySelectorAll('.footer-biz-title, .footer-biz-tag, .biz-main-title, .biz-badge-pill');
    bizTitles.forEach(el => {
      if (el) {
        el.style.cursor = 'pointer';
        el.title = 'Haz clic para desplegar el formulario de postulación';
        el.addEventListener('click', () => {
          if (formCollapse && !formCollapse.classList.contains('is-expanded')) {
            openBizForm(true);
          }
        });
      }
    });

    // Enlace en Módulos Web del footer
    const footerLink = document.getElementById('footerLinkRegBiz');
    if (footerLink) {
      footerLink.addEventListener('click', (e) => {
        e.preventDefault();
        openBizForm(true);
      });
    }

    // Abrir automáticamente si la URL contiene el hash #registroNegocios
    if (window.location.hash === '#registroNegocios') {
      setTimeout(() => openBizForm(true), 250);
    }
    window.addEventListener('hashchange', () => {
      if (window.location.hash === '#registroNegocios') {
        openBizForm(true);
      }
    });

    // Contador reactivo de caracteres
    if (descInput && charCounter) {
      descInput.addEventListener('input', function() {
        charCounter.textContent = `${this.value.length} / 300`;
      });
    }

    // Manejo de archivo y preview de imagen
    if (photoInput && previewBox && previewImg) {
      photoInput.addEventListener('change', function(e) {
        const file = e.target.files && e.target.files[0];
        if (file) {
          if (file.size > 5 * 1024 * 1024) {
            alert('La fotografía debe ser menor a 5MB.');
            photoInput.value = '';
            return;
          }
          const reader = new FileReader();
          reader.onload = function(evt) {
            previewImg.src = evt.target.result;
            if (placeholder) placeholder.style.display = 'none';
            previewBox.style.display = 'block';
          };
          reader.readAsDataURL(file);
        }
      });

      if (btnRemovePhoto) {
        btnRemovePhoto.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          photoInput.value = '';
          previewImg.src = '';
          previewBox.style.display = 'none';
          if (placeholder) placeholder.style.display = 'flex';
        });
      }
    }

    // Cerrar modal de confirmación
    function closeModal() {
      if (modal) {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
      }
    }
    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
    if (modalAcceptBtn) modalAcceptBtn.addEventListener('click', closeModal);

    // Validación y Envío del Formulario
    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      // Limpiar errores previos
      form.querySelectorAll('.biz-error-msg').forEach(el => el.textContent = '');
      form.querySelectorAll('.biz-input, .biz-select, .biz-textarea').forEach(el => el.classList.remove('has-error'));

      let isValid = true;
      function markError(fieldId, msg) {
        const field = document.getElementById(fieldId);
        const err = document.getElementById('err-' + fieldId);
        if (field) field.classList.add('has-error');
        if (err) err.textContent = msg;
        if (isValid && field) field.focus();
        isValid = false;
      }

      const name = document.getElementById('bizName').value.trim();
      const type = document.getElementById('bizType').value;
      const owner = document.getElementById('bizOwner').value.trim();
      const category = document.getElementById('bizCategory').value;
      const department = document.getElementById('bizDepartment').value;
      const municipality = document.getElementById('bizMunicipality').value.trim();
      const address = document.getElementById('bizAddress').value.trim();
      const phone = document.getElementById('bizPhone').value.trim();
      const whatsapp = document.getElementById('bizWhatsapp').value.trim();
      const email = document.getElementById('bizEmail').value.trim();
      const website = document.getElementById('bizWebsite').value.trim();
      const price = document.getElementById('bizPrice').value.trim();
      const schedule = document.getElementById('bizSchedule').value.trim();
      const description = descInput ? descInput.value.trim() : '';
      const terms = document.getElementById('bizTerms').checked;

      if (!name) markError('bizName', 'Por favor ingresa el nombre del negocio');
      if (!type) markError('bizType', 'Selecciona el tipo de negocio');
      if (!owner) markError('bizOwner', 'Ingresa el nombre del propietario o responsable');
      if (!category) markError('bizCategory', 'Selecciona la categoría Baqueano');
      if (!department) markError('bizDepartment', 'Selecciona el departamento');
      if (!municipality) markError('bizMunicipality', 'Ingresa el municipio');
      if (!address) markError('bizAddress', 'Indica la dirección o referencia exacta');
      if (!phone) markError('bizPhone', 'Ingresa un teléfono principal de contacto');
      if (!description) markError('bizDescription', 'Escribe una breve descripción del servicio');
      if (!terms) markError('bizTerms', 'Debes aceptar los términos de turismo justo');

      if (!isValid) return;

      // Estado de carga en botón
      const originalBtnHtml = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Registrando en Mesa Baqueano...';

      const payload = {
        name: name,
        businessType: type,
        owner: owner,
        category: category,
        department: department,
        municipality: municipality,
        address: address,
        phone: phone,
        whatsapp: whatsapp || phone,
        email: email || '',
        website: website || '',
        priceApproxNio: price ? Number(price) : null,
        schedule: schedule || '',
        description: description,
        hasPhoto: Boolean(photoInput && photoInput.files && photoInput.files.length > 0),
        acceptedTerms: true,
        source: 'index_landing_registration'
      };

      try {
        // 1. Guardar en Firestore si el módulo está disponible
        if (window.BaqueanoFirestore && typeof window.BaqueanoFirestore.registerBusiness === 'function') {
          try {
            await window.BaqueanoFirestore.registerBusiness(payload);
          } catch (eFirestore) {
            console.warn('[RegistroNegocios] Guardado local/offline:', eFirestore);
          }
        }

        // 2. Construir mensaje enriquecido para WhatsApp Business
        const waLines = [
          '🇳🇮 *POSTULACIÓN DE NEGOCIO — BAQUEANO NICARAGUA*',
          '━━━━━━━━━━━━━━━━━━━━━━━━━━━━',
          `🏪 *Negocio:* ${name}`,
          `🏷️ *Tipo:* ${type}`,
          `📂 *Categoría:* ${category}`,
          `👤 *Responsable:* ${owner}`,
          `📍 *Ubicación:* ${municipality}, ${department}`,
          `🗺️ *Dirección:* ${address}`,
          `📞 *Teléfono:* ${phone}`,
          whatsapp ? `💬 *WhatsApp:* ${whatsapp}` : '',
          email ? `✉️ *Email:* ${email}` : '',
          website ? `🌐 *Enlace:* ${website}` : '',
          price ? `💵 *Precio Base:* C$ ${price}` : '',
          schedule ? `⏰ *Horario:* ${schedule}` : '',
          `📝 *Descripción:* ${description}`,
          '━━━━━━━━━━━━━━━━━━━━━━━━━━━━',
          '✅ _Aceptó términos de turismo justo sin intermediarios._'
        ].filter(Boolean).join('\n');

        const waUrl = `https://wa.me/50584431289?text=${encodeURIComponent(waLines)}`;

        // 3. Poblar modal de resumen y abrir WhatsApp
        if (modalSummary) {
          modalSummary.innerHTML = `
            <div class="index-inline-066"><strong>Negocio:</strong> ${name}</div>
            <div class="index-inline-066"><strong>Ubicación:</strong> ${municipality}, ${department}</div>
            <div class="index-inline-066"><strong>Responsable:</strong> ${owner}</div>
            <div><strong>Contacto:</strong> ${phone}</div>
          `;
        }
        if (modalWhatsAppBtn) {
          modalWhatsAppBtn.href = waUrl;
        }

        if (modal) {
          modal.classList.add('is-open');
          modal.setAttribute('aria-hidden', 'false');
        }

        // Abrir WhatsApp en nueva pestaña
        window.open(waUrl, '_blank', 'noopener,noreferrer');

        // Limpiar formulario
        form.reset();
        if (charCounter) charCounter.textContent = '0 / 300';
        if (previewBox && placeholder) {
          previewBox.style.display = 'none';
          placeholder.style.display = 'flex';
        }

      } catch (err) {
        console.error('[RegistroNegocios] Error procesando postulación:', err);
        alert('Hubo un inconveniente al procesar la solicitud. Por favor intenta nuevamente.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
      }
    });

  })();
  </script>
  <script src="js/persistent-audio-player.js?v=20260922-3"></script>
  <script src="js/theme-switcher.js"></script>
  <script src="js/territories-data.js"></script>
  <script src="js/territory-inspector.js"></script>
  <script src="js/baqueano-reels.js"></script>
</body>
</html>
