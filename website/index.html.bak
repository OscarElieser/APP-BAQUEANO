        <button class="btn-hero-primary index-inline-061" id="btnSendWhatsAppSos">
          <i class="fa-brands fa-whatsapp"></i> Enviar Alerta con Coordenadas GPS
        </button>
        <button class="btn-hero-glass index-inline-062" id="btnCopyGpsSos">
          <i class="fa-solid fa-copy"></i> Copiar Coordenadas al Portapapeles
        </button>
