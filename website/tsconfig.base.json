{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@baqueano/ui": ["packages/ui/src"],
      "@baqueano/types": ["packages/types/src"],
      "@baqueano/firebase": ["packages/firebase/src"],
      "@baqueano/validators": ["packages/validators/src"],
      "@baqueano/design-system": ["packages/design-system/src"],
      "@baqueano/config": ["packages/config/src"]
    }
  }
}
