# WHY
# Documents the public runtime configuration without committing real project values.
# HOW
# Copy to .env.local and replace every placeholder locally. Keep that file untracked.
# WHAT
# Safe placeholders shared by the public and administration Next.js applications.
NEXT_PUBLIC_BAQUEANO_ENV=development
NEXT_PUBLIC_BAQUEANO_VERSION=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-public-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-web-app-id
# Server-only secrets. Generate independent random values and never prefix with NEXT_PUBLIC.
BAQUEANO_TRIP_PASS_SIGNING_KEY=replace-with-at-least-32-random-bytes
BAQUEANO_INTERNAL_API_KEY=replace-with-an-independent-random-secret
