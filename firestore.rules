rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 🏪 NEGOCIOS & COMERCIOS LOCALES
    // Lectura pública solo para publicados; administradores leen y gestionan todo
    match /businesses/{businessId} {
      allow read: if resource == null || resource.data.status == 'published' || request.auth != null;
      allow write: if request.auth != null;
    }

    // 🌋 DESTINOS & EXPEDICIONES
    match /destinations/{destinationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 🗂️ CENTRO MULTIMEDIA CENTRALIZADO
    match /multimedia/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 📖 HISTORIA DE MI PAÍS & PATRIMONIO CULTURAL
    match /countries/{countryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ⚙️ CONFIGURACIÓN REMOTA GLOBAL
    match /app_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 🛡️ REGISTRO DE AUDITORÍA INMUTABLE
    // Solo creación por administradores; prohibida la edición o borrado
    match /audit_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // 👤 PERFILES DE EXPLORADORES
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'super_admin');
    }

    // 🎫 RESERVAS DE EXPEDICIONES
    match /reservations/{reservationId} {
      allow read, write: if request.auth != null;
    }

    // 🆘 ALERTAS SOS & CONTINGENCIA
    match /sos_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
