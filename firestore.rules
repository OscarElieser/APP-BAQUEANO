rules_version = '2';

// ============================================================================
// BAQUEANO — REGLAS DE AUTORIZACIÓN FIRESTORE DE PRODUCCIÓN
// ============================================================================
//
// POR QUÉ:
// - La identidad, las reservas, los mensajes y el dinero no pueden depender de
//   datos que el APK pueda fabricar o modificar.
// - Cada lectura privada debe pertenecer al usuario, anfitrión o administrador.
//
// CÓMO:
// - Custom claims determinan privilegios administrativos; nunca un campo escrito
//   por el cliente.
// - Las solicitudes offline admiten solo intención mínima. Cloud Functions crea
//   reservas, órdenes, transacciones y membresías con valores verificados.
// - Las actualizaciones de participantes usan listas blancas y transiciones de
//   estado explícitas; el resto queda denegado por defecto.
//
// QUÉ:
// - Políticas de propietario/participante para perfiles, negocios, reservas,
//   conversaciones, mensajes, avisos, pagos, directorio y alertas SOS.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.admin == true
          || request.auth.token.role == 'admin'
          || request.auth.token.role == 'super_admin'
          // Correo oficial solo si Firebase confirmó que el usuario lo controla
          // (email_verified). Evita heredar privilegios con un correo ajeno.
          || (request.auth.token.email_verified == true
            && request.auth.token.email in [
            'oscarelieser.informatica.inatec@gmail.com',
            'byoscarelieser@gmail.com',
            'vigoronmixt@gmail.com'
          ]));
    }

    // Superadministrador: único que puede depurar la auditoría.
    function isSuperAdmin() {
      return isSignedIn()
        && (request.auth.token.role == 'super_admin'
          || (request.auth.token.email_verified == true
            && request.auth.token.email == 'oscarelieser.informatica.inatec@gmail.com'));
    }

    // AUDITOR (solo lectura, docs/security/ROLES_Y_PERMISOS.md): custom claim
    // `role: auditor` con correo verificado. Lee contenido y paneles operativos
    // del Ops Center; nunca escribe ni ve datos privados (SOS, pagos, reservas
    // ni mensajes).
    function isAuditor() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.role == 'auditor';
    }

    function isStaffReader() {
      return isAdmin() || isAuditor();
    }

    function isOwner(ownerUid) {
      return isSignedIn() && ownerUid == request.auth.uid;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    function isShortText(data, field, maxSize) {
      return data.get(field, '') is string && data.get(field, '').size() <= maxSize;
    }

    // 🎯 POR QUÉ: el usuario crea y edita sus propios datos desde el perfil
    //    (web y app); antes no existía ningún campo editable para ellos.
    // ⚙️ CÓMO: un único mapa `profile` con lista blanca de claves, tipos y
    //    tamaños. Rol, XP, sellos e insignias quedan fuera de este mapa.
    // 📦 QUÉ: teléfono, ubicación, contacto de emergencia, idioma, moneda,
    //    intereses, alimentación, accesibilidad y consentimientos.
    function isValidConsents(consents) {
      return consents is map
        && consents.keys().hasOnly(['location', 'personalization', 'analytics'])
        && consents.get('location', false) is bool
        && consents.get('personalization', false) is bool
        && consents.get('analytics', false) is bool;
    }

    function isValidProfileDetails(details) {
      return details is map
        && details.keys().hasOnly([
          'phone', 'city', 'country', 'emergencyContact', 'language',
          'currency', 'interests', 'dietary', 'accessibility', 'consents'
        ])
        && isShortText(details, 'phone', 30)
        && isShortText(details, 'city', 80)
        && isShortText(details, 'country', 80)
        && isShortText(details, 'emergencyContact', 120)
        && isShortText(details, 'dietary', 300)
        && isShortText(details, 'accessibility', 300)
        && details.get('language', 'es') in ['es', 'en', 'fr', 'it', 'pt', 'de']
        && details.get('currency', 'NIO') in ['NIO', 'USD']
        && details.get('interests', []) is list
        && details.get('interests', []).size() <= 12
        && details.get('interests', []).hasOnly([
          'playas', 'volcanes', 'senderismo', 'gastronomia', 'cafe',
          'cascadas', 'cultura', 'familiar', 'fotografia', 'aventura'
        ])
        && isValidConsents(details.get('consents', {}));
    }

    // Perfiles privados. El cliente nunca puede asignarse rol, XP ni insignias.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('email', '') == request.auth.token.get('email', '')
        && request.resource.data.get('role', 'explorer') == 'explorer'
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoUrl', 'role', 'explorerLevel',
          'xp', 'stamps', 'badges', 'favorites', 'createdAt', 'updatedAt',
          'privacyConsentAt', 'profile'
        ])
        && request.resource.data.get('xp', 0) == 0
        && request.resource.data.get('stamps', []).size() == 0
        && request.resource.data.get('badges', []).size() == 0
        && isShortText(request.resource.data, 'displayName', 120)
        && isValidProfileDetails(request.resource.data.get('profile', {}));
      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && onlyChanges([
            'displayName', 'photoUrl', 'explorerLevel', 'favorites',
            'privacyConsentAt', 'updatedAt', 'profile'
          ])
          && isShortText(request.resource.data, 'displayName', 120)
          && isValidProfileDetails(request.resource.data.get('profile', {})));
      allow delete: if isOwner(userId) || isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create, delete: if false;
        allow update: if isOwner(userId)
          && onlyChanges(['isRead', 'readAt']);
      }

      match /devices/{deviceId} {
        allow read, create, update, delete: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'token', 'platform', 'createdAt', 'updatedAt', 'appVersion'
          ]);
      }
    }

    // Catálogo público: solo contenido aprobado. Toda escritura es administrativa.
    match /destinations/{destinationId} {
      allow read: if isPublished() || isStaffReader();
      allow write: if isAdmin();
    }

    match /businesses/{businessId} {
      allow read: if isPublished()
        || isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.get('verified', false) == false
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'description', 'category', 'department',
          'municipality', 'address', 'phone', 'email', 'website', 'imageUrl',
          'galleryUrls', 'coordinates', 'status', 'verified', 'createdAt',
          'updatedAt'
        ]);
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('verified', false)
            == resource.data.get('verified', false)
          && onlyChanges([
            'name', 'description', 'category', 'department', 'municipality',
            'address', 'phone', 'email', 'website', 'imageUrl', 'galleryUrls',
            'coordinates', 'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    // Tarifas turísticas: lectura pública para transparencia; toda mutación y
    // verificación exige privilegio administrativo emitido por custom claims.
    match /tourism_services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /priceHistory/{historyId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    // Cartografía territorial web: solo fichas y opiniones ya publicadas.
    // El navegador nunca puede aprobar, editar ni fabricar ubicaciones o ratings.
    match /tourismPlaces/{placeId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // El tipo de cambio es público, pero solo Ops Center puede actualizarlo.
    match /app_config/exchange_rate {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Historial privado de itinerarios y snapshot de precios del propietario.
    match /travelPlans/{planId} {
      allow read, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.totalCost <= request.resource.data.availableBudget;
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.totalCost <= request.resource.data.availableBudget);
    }

    match /multimedia/{mediaId} {
      allow read: if isPublished() || isStaffReader();
      allow write: if isAdmin();
    }

    match /countries/{countryId} {
      allow read: if isPublished() || isStaffReader();
      allow write: if isAdmin();
    }

    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /android_releases/{releaseId} {
      allow read: if isStaffReader();
      allow write: if isAdmin();
    }

    // Una solicitud puede guardarse offline, pero no contiene precios ni aprobación.
    match /reservation_requests/{requestId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.touristUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.touristUid == request.auth.uid
        && request.resource.data.status == 'queued'
        && request.resource.data.participants is int
        && request.resource.data.participants >= 1
        && request.resource.data.participants <= 20
        && request.resource.data.destinationId is string
        && request.resource.data.destinationId.size() > 0
        && request.resource.data.keys().hasOnly([
          'requestId', 'touristUid', 'destinationId', 'requestedDate',
          'participants', 'isForeignTourist', 'contactName', 'contactPhone',
          'contactEmail', 'nationality', 'status', 'createdAt', 'schemaVersion'
        ]);
      allow update, delete: if false;
    }

    function isReservationParticipant() {
      return isSignedIn()
        && (resource.data.touristUid == request.auth.uid
          || resource.data.hostUid == request.auth.uid);
    }

    function touristCanRequestCancellation() {
      return isSignedIn()
        && resource.data.touristUid == request.auth.uid
        && resource.data.status in [
          'pending_host', 'accepted', 'pending_payment'
        ]
        && request.resource.data.status == 'cancellation_requested'
        && onlyChanges(['status', 'updatedAt']);
    }

    function hostCanDecide() {
      return isSignedIn()
        && resource.data.hostUid == request.auth.uid
        && resource.data.status == 'pending_host'
        && request.resource.data.status in ['accepted', 'rejected']
        && onlyChanges(['status', 'hostNote', 'updatedAt']);
    }

    match /reservations/{reservationId} {
      allow read: if isReservationParticipant() || isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        || touristCanRequestCancellation()
        || hostCanDecide();
    }

    function conversation(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn()
        && conversation(conversationId).data.participantUids
          .hasAny([request.auth.uid]);
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && resource.data.participantUids.hasAny([request.auth.uid]);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.status == 'sent'
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.keys().hasOnly([
            'messageId', 'senderUid', 'text', 'createdAt', 'status',
            'relatedReservationId', 'attachmentPath', 'schemaVersion'
          ]);
        allow update: if isConversationParticipant(conversationId)
          && resource.data.senderUid != request.auth.uid
          && request.resource.data.status == 'read'
          && onlyChanges(['status', 'readAt']);
        allow delete: if false;
      }
    }

    // El backend crea y confirma toda entidad financiera.
    match /payment_orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.createdByUid == request.auth.uid);
      allow write: if false;
    }

    match /payment_transactions/{transactionId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.createdByUid == request.auth.uid);
      allow write: if false;
    }

    match /business_subscriptions/{businessId} {
      allow read: if isAdmin()
        || (isSignedIn()
          && get(/databases/$(database)/documents/businesses/$(businessId))
            .data.ownerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Auditoría: nadie la edita; solo el superadministrador depura registros
    // (retención). Antes un segundo bloque `match /audit_logs` con
    // `allow read, write: if isAdmin()` anulaba esta inmutabilidad.
    match /audit_logs/{logId} {
      allow read: if isStaffReader();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Telemetría anónima: esquema cerrado y tamaños acotados para que nadie la
    // use como almacenamiento libre (antes: `allow create: if true`).
    match /traffic_sessions/{sessionId} {
      allow create: if request.resource.data.keys().hasOnly([
          'id', 'sessionId', 'platform', 'page', 'path', 'referrer', 'clientIp',
          'userAgent', 'appVersion', 'deviceModel', 'userId', 'isGuest',
          'timestamp', 'status'
        ])
        && isShortText(request.resource.data, 'page', 200)
        && isShortText(request.resource.data, 'path', 300)
        && isShortText(request.resource.data, 'referrer', 300)
        && isShortText(request.resource.data, 'userAgent', 400)
        && isShortText(request.resource.data, 'userId', 200)
        && isShortText(request.resource.data, 'sessionId', 100);
      allow read: if isStaffReader();
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    // Alertas autenticadas se pueden encolar offline; solo operaciones las consulta.
    match /sos_logs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userUid', 'coordinates', 'emergencyType', 'createdAt',
          'platform', 'status'
        ]);
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /places/{placeId} {
      allow read: if isPublished() || isStaffReader();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /municipalities/{municipalityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /experiences/{expId} {
      allow read: if isPublished() || isStaffReader();
      allow write: if isAdmin();
    }

    match /cultural_items/{itemId} {
      allow read: if isPublished() || isStaffReader();
      allow write: if isAdmin();
    }

    match /gastronomy/{dishId} {
      allow read: if isPublished() || isStaffReader();
      allow write: if isAdmin();
    }

    match /history_timeline/{periodId} {
      allow read: if isPublished() || isStaffReader();
      allow write: if isAdmin();
    }

    match /sustainability_initiatives/{initId} {
      allow read: if isPublished() || isStaffReader();
      allow write: if isAdmin();
    }

    match /environmental_reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isStaffReader();
      allow update, delete: if isAdmin();
    }

    match /emergency_directory/{dirId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();

      match /sections/{sectionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /site_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();

      match /sections/{sectionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /roles/{roleId} {
      allow read: if isStaffReader();
      allow write: if isAdmin();
    }

    match /ai_tasks/{taskId} {
      allow read: if isStaffReader();
      allow write: if isAdmin();
    }

    match /ai_settings/{settingId} {
      allow read: if isStaffReader();
      allow write: if isAdmin();
    }


    match /user_saved_places/{savedId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'placeId', 'savedAt'
        ]);
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
