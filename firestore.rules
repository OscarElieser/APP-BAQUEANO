rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Destinos y catálogo cultural (lectura pública, escritura autenticada)
    match /destinations/{destinationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Perfiles de exploradores (cada usuario lee y modifica su propio perfil)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Reservas de expediciones (acceso del explorador y del administrador)
    match /reservations/{reservationId} {
      allow read, write: if request.auth != null;
    }

    // Registro de alertas SOS y contingencia (escritura abierta para auxilio rápido)
    match /sos_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
