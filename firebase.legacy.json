{
  "_comentario": [
    "BAQUEANO — CONFIGURACIÓN FIREBASE EN PAUSA (decisión del propietario, 2026-10-05).",
    "POR QUÉ: el sitio público vive solo en baqueanonicaragua.com (Azure). Firebase se conserva para Authentication y APIs (Functions).",
    "CÓMO: estos bloques salieron de firebase.json para que `firebase deploy` ya no publique Hosting, reglas de Firestore/Storage ni RTDB.",
    "Se guardan intactos para el futuro: para reactivar uno, copiar su bloque de vuelta a firebase.json.",
    "NO deshabilitar el sitio de Hosting app-baqueano en la consola: el handler de login /__/auth/* vive en app-baqueano.firebaseapp.com.",
    "Retiro de la copia pública web.app: firebase.hosting-redirect.json (despliegue único, requiere autorización)."
  ],
  "hosting": {
    "site": "app-baqueano",
    "public": "website",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/docs/**",
      "**/scripts/**",
      "**/dev-*.log",
      "**/*.log",
      "**/apps/**",
      "**/packages/**",
      "**/pnpm-*",
      "**/tsconfig*",
      "**/package*",
      "**/local-keys.js",
      "qa-*.png",
      "audit-*.png",
      "**/*.md",
      "**/*.apk",
      "**/*.aab",
      "**/*.exe",
      "**/*.msi",
      "**/*.bat",
      "**/*.cmd",
      "**/*.com",
      "**/*.dll",
      "**/*.bin",
      "assets/videos/video 2.mp4",
      "assets/videos/video 2 (1).mp4",
      "assets/videos/video nicaragua (1).mp4",
      "assets/videos/destinos (1).mp4",
      "assets/videos/gastronomia (1).mp4",
      "assets/videos/historia (1).mp4",
      "assets/videos/video (1).mp4",
      "assets/videos/[[]preview[]]destinos.mp4",
      "**/*.crdownload",
      "assets/BaqueanoNicaragua.apk",
      "assets/videos/*preview*",
      "assets/videos/*(1)*",
      "assets/videos/* (1)*",
      "assets/videos/[preview]destinos.mp4"
    ],
    "redirects": [
      {
        "source": "/baqueano-ai",
        "destination": "/baqueano-ai.html",
        "type": 301
      },
      {
        "source": "/privacidad",
        "destination": "/privacidad.html",
        "type": 301
      },
      {
        "source": "/terminos",
        "destination": "/terminos.html",
        "type": 301
      },
      {
        "source": "/negocio",
        "destination": "/mi-negocio.html",
        "type": 301
      },
      {
        "source": "/mapa",
        "destination": "/mapa.html",
        "type": 301
      },
      {
        "source": "/departamentos",
        "destination": "/departamento.html",
        "type": 302
      },
      {
        "source": "/departamentos.html",
        "destination": "/departamento.html",
        "type": 302
      },
      {
        "source": "/ops",
        "destination": "/admin.html",
        "type": 301
      },
      {
        "source": "/ops-center",
        "destination": "/admin.html",
        "type": 301
      },
      {
        "source": "/admin",
        "destination": "/admin.html",
        "type": 301
      },
      {
        "source": "/dashboard",
        "destination": "/admin.html",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(self), camera=(), microphone=(self), payment=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://apis.google.com https://www.googletagmanager.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; media-src 'self' blob: https://heiudfpthqwtjrtluqlm.supabase.co; img-src 'self' data: blob: https://heiudfpthqwtjrtluqlm.supabase.co https://*.openstreetmap.org https://firebasestorage.googleapis.com https://lh3.googleusercontent.com https://*.google.com https://*.googleapis.com https://*.gstatic.com https://*.arcgisonline.com https://*.cartocdn.com https://images.unsplash.com https://video-previews.elements.envatousercontent.com; connect-src 'self' https://api.open-meteo.com https://*.supabase.co wss://*.supabase.co https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebaseinstallations.googleapis.com https://*.google.com https://*.arcgisonline.com https://nominatim.openstreetmap.org; worker-src 'self' blob:; child-src 'self' blob:; frame-src https://app-baqueano.firebaseapp.com; object-src 'none'; base-uri 'self';"
          }
        ]
      },
      {
        "source": "admin.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(woff|woff2|ttf|otf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(mp4|webm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|avif)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, s-maxage=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "manifest.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": [
    {
      "database": "appbaqueano",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "database": {
      "port": 9000
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
