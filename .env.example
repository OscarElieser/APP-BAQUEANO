# ============================================================================
# 🧭 BAQUEANO NICARAGUA — VARIABLES DE ENTORNO (PLANTILLA OFICIAL)
# ============================================================================
#
# 🎯 1. POR QUÉ (WHY / PROPÓSITO):
# Proveer la plantilla canónica de configuración y secretos para el ecosistema
# Baqueano (Firebase Hosting, Cloud Functions Gen 2, Cloud Run y Supabase).
# NUNCA DEPOSITAR SECRETOS REALES EN ESTE ARCHIVO NI SUBIRLOS A CONTROL DE VERSIONES.
#
# ⚙️ 2. CÓMO (HOW / ARQUITECTURA & GESTIÓN DE SECRETOS):
# - En Google Cloud / Firebase Functions: los secretos sensibles (API Keys y
#   claves service_role) se administran exclusivamente mediante Google Secret Manager
#   a través de `firebase functions:secrets:set NOMBRE_SECRETO`.
# - En desarrollo local con Firebase Emulators: copiar este archivo como
#   `functions/.env.local` y definir los valores pertinentes.
#
# 📦 3. QUÉ (WHAT / CONFIGURACIÓN DEL ECOSISTEMA):
# ============================================================================

# Entorno de Ejecución
NODE_ENV=production
PORT=8080

# ----------------------------------------------------------------------------
# 1. SUPABASE (RESPALDO, POSTGIS, PGVECTOR & STORAGE FAILOVER)
# ----------------------------------------------------------------------------
SUPABASE_PROJECT_REF=heiudfpthqwtjrtluqlm
SUPABASE_URL=https://heiudfpthqwtjrtluqlm.supabase.co
# Clave anónima pública con Row Level Security (RLS) activo
SUPABASE_ANON_KEY=sb_publishable_q7ZhqRIRjlerZK7WOu_Qxw_X_AqXV1d
# Clave Service Role (SOLO en backend via Google Secret Manager — NUNCA en frontend)
# SUPABASE_SERVICE_ROLE_KEY=
# Contraseña de la base de datos PostgreSQL (solo para migraciones directas)
# SUPABASE_DB_PASSWORD=

# ----------------------------------------------------------------------------
# 2. MOTOR DE INTELIGENCIA ARTIFICIAL (MULTI-LLM & RAG TERRITORIAL)
# ----------------------------------------------------------------------------
# Proveedor principal: gemini | groq | ollama
AI_PROVIDER=gemini
AI_MAX_TOKENS=1500
AI_RATE_LIMIT=10
AI_TIMEOUT_MS=8000

# Google Gemini Flash (Gestionado en Google Secret Manager: defineSecret)
# GEMINI_API_KEY=

# Groq Cloud Llama 3.3 (Fallback de alta velocidad — opcional)
# GROQ_API_KEY=

# Ollama Local (Fallback local de contingencia soberana — opcional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Proveedores de contingencia secundaria
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# ----------------------------------------------------------------------------
# 3. FIREBASE & CLOUD STORAGE
# ----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=app-baqueano
FIREBASE_STORAGE_BUCKET=app-baqueano.firebasestorage.app
SUPABASE_STORAGE_BACKUP_BUCKET=baqueano-backup-media

# ----------------------------------------------------------------------------
# 4. POLÍTICAS DE RESILIENCIA Y BACKOFF
# ----------------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
BACKUP_RETRY_BACKOFF_STEPS_SEC=60,300,900,3600,21600
