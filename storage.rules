rules_version = '2';

// ============================================================================
// BAQUEANO — REGLAS DE ARCHIVOS CON PROPIEDAD Y MÍNIMO PRIVILEGIO
// ============================================================================
//
// POR QUÉ:
// - Una cuenta autenticada no debe sustituir fotos oficiales, archivos de otro
//   negocio ni adjuntos de conversaciones ajenas.
//
// CÓMO:
// - Claims administrativos protegen medios editoriales; perfiles se aíslan por
//   UID y los adjuntos exigen participación en la conversación correspondiente.
// - MIME, tamaño y nombre de archivo se validan antes de aceptar cada escritura.
//
// QUÉ:
// - Rutas seguras para perfiles, negocios, destinos, multimedia y chat.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.admin == true
          || request.auth.token.role == 'admin'
          || request.auth.token.role == 'super_admin'
          || request.auth.token.email in [
            'oscarelieser.informatica.inatec@gmail.com',
            'byoscarelieser@gmail.com',
            'vigoronmixt@gmail.com'
          ]);
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= 8 * 1024 * 1024;
    }

    function isAudio() {
      return request.resource != null
        && request.resource.contentType.matches('audio/(mpeg|mp4|ogg|wav)')
        && request.resource.size <= 12 * 1024 * 1024;
    }

    function ownsBusiness(businessId) {
      return isSignedIn()
        && firestore.get(
          /databases/(default)/documents/businesses/$(businessId)
        ).data.ownerUid == request.auth.uid;
    }

    function participatesIn(conversationId) {
      return isSignedIn()
        && firestore.get(
          /databases/(default)/documents/conversations/$(conversationId)
        ).data.participantUids.hasAny([request.auth.uid]);
    }

    function isEvidenceDocument() {
      return request.resource != null
        && request.resource.contentType.matches(
          '(application/pdf|image/(jpeg|png|webp))'
        )
        && request.resource.size <= 12 * 1024 * 1024;
    }

    match /users/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && isImage();
    }

    match /businesses/{businessId}/{fileName} {
      allow read: if true;
      allow write: if (isAdmin() || ownsBusiness(businessId)) && isImage();
    }

    match /destinations/{destinationId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage();
    }

    match /multimedia/{mediaId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && (isImage() || isAudio());
    }

    match /pages/{pageId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage();
    }

    match /uploads/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && (isImage() || isAudio() || isEvidenceDocument());
    }

    match /conversations/{conversationId}/{messageId}/{fileName} {
      allow read: if participatesIn(conversationId);
      allow write: if participatesIn(conversationId) && isImage();
    }

    // Verification evidence is never public or available to regular clients.
    // Trusted backend code retains access through the Admin SDK.
    match /trust/{resourceId}/evidence/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isEvidenceDocument();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
